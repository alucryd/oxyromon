  "claims": [
    {
      "id": "claim_98400b462b5344caa604fedd009ca2c6",
      "statement": "oxyromon is a cross-platform Rust CLI ROM organizer that validates ROM files against Logiqx DAT catalogs (No-Intro, Redump, MAME/FBNeo), imports them into a managed directory tree, sorts by region/1G1R preference and converts/exports between formats; the same binary optionally serves a GraphQL API with an embedded web UI and the Model Context Protocol, both behind Cargo features and both reusing the CLI subcommand implementations rather than reimplementing them.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md#L5-L18",
          "version": "repo-lines-v1:sha256:450a97e2d5bae9d705b19beceea01aa7973b9085f653b2f7d99ce7d7ee6e5164:"
        },
