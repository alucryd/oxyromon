  "claims": [
    {
      "id": "claim_576b8c67163e49f78677876793d52f3a",
      "statement": "The SSE transport is a single tokio broadcast channel of capacity 100 (broadcast::channel::<SseMessage>(100)) created in server::main together with one CancellationToken; the Sender is handed to axum through AppState and to GraphQL resolvers through Schema::data, so mutations, the four upload handlers and the nested MCP HTTP service all publish onto the same bus. SseMessage is { event: String, data: String } — the JSON payload is serialized once at the sender and every subscriber receives identical bytes.",
      "evidence": [
        {
          "resource": "repo://src/mutation.rs#L11-L19",
          "version": "repo-lines-v1:sha256:fb7fcab8c6d4fdf5615c898a010934c29557f67688433a1daf5a33756826e941:"
        },
        {
