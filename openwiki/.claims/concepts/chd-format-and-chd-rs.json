    {
      "id": "claim_98ae382beba44dffbd9b86737633ec65",
      "statement": "as_chd resolves a CHD's parent by scanning its own directory for another CHD whose CHD SHA-1 equals the parent SHA-1 in the header, while as_chd_with_parent takes the parent from the caller and fails with a SHA-1 mismatch error when the header disagrees.",
