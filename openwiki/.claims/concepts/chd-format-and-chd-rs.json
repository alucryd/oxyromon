    {
      "id": "claim_f5e6f45c5349449d88e0b55f32300d12",
      "statement": "create_chd applies chdman's defaults when the codec list is empty (cdlz, cdzl, cdfl for CDs, avhu for LaserDiscs, lzma, zlib, huff, flac otherwise); a given list is packed in order into the header's four compression slots by codecs(), which leaves all slots empty for `none` alone and rejects more than four entries. An unset hunk size takes the parent's, else 8 CD frames for a CD or 4096 bytes, while a LaserDisc hunk size is left to create_ld.",
      "evidence": [
        {
          "resource": "repo://src/chd.rs#L716-L789",
          "version": "repo-lines-v1:sha256:5e53cd6954f0bcc8e87be86157a64269924342e920503fbe75358bc46269aa70:"
