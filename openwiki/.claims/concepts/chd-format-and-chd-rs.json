    {
      "id": "claim_ff11222a8c724ab7859b3b21a8ad8d1a",
      "statement": "parse_chd maps the crate's ChdInfo onto oxyromon's ChdType and returns logical size, data SHA-1, the CHD's own SHA-1, the parent SHA-1 and the track count; a CD yields size 0 and an empty data SHA-1 because only its tracks have a size and hash, and any type other than CD, DVD or LaserDisc is treated as a hard disk.",
      "evidence": [
