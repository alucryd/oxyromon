    {
      "id": "claim_0bee4b61b5f74f62983a30d7c9d5ab48",
      "statement": "import_rom() resolves a single extension string for dispatch: it calls get_mimetype and uses mimetype.extension() when a matcher fired, otherwise falls back to path.extension() lowercased; that string then selects the archive / CHD / CIA / CSO / NSZ / RVZ / ZSO / import_other cascade, and every non-default branch is additionally gated on !as_is so --as-is sends any container straight to import_other. import_roms::main reuses the same detection to order parent-declaring CHDs before their parents and to unpack top-level archives under --extract.",
      "evidence": [
        {
          "resource": "repo://src/import_roms.rs#L178-L237",
          "version": "repo-lines-v1:sha256:c5ae3695350fe2c1f4730e1faa48f317d6b2b9a6b06d61007eabea44c9b9b26e:"
