    {
      "id": "claim_e2459c8758654a3e9c6a13f650ff3bd0",
      "statement": "With chdman gone, src/util.rs exposes no run_tool and no tool_available helper, and nothing on the ctrtool path logs the assembled tokio::process::Command at debug level: tool_version is the only shared subprocess helper, and status interpretation plus the missing-tool message live at each call site, so the exact argv passed to ctrtool is not recoverable from the debug log.",
      "evidence": [
        {
          "resource": "repo://src/ctrtool.rs#L101-L121",
          "version": "repo-lines-v1:sha256:80a3d304236a0ba5d709acfbecedc0b08c18fa79d06024bd19b38fb04777ff4b:"
        },
        {
          "resource": "repo://src/ctrtool.rs#L36-L48",
          "version": "repo-lines-v1:sha256:ec6e027a07906f43bd8ac02fa476c5c9c49592f7c57e75d2dc805225dfe2d6b0:"
