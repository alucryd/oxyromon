    {
      "id": "claim_4574f56cdfe7474ba7de65c5cbfca04a",
      "statement": "util::create_tmp_directory creates its tempfile::TempDir inside config::get_tmp_directory rather than the OS default, so intermediate disc images land on the filesystem chosen by the TMP_DIRECTORY setting (bootstrapped from OXYROMON_TMP_DIRECTORY or env::temp_dir()); the TempDir is held for the whole extract-verify-convert sequence because dropping it deletes the directory.",
      "evidence": [
        {
          "resource": "repo://src/config.rs#L623-L635",
