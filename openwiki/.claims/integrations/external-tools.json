    {
      "id": "claim_c29441513df94e60a5d3f311feba9f0f",
      "statement": "All three chdman call sites build Command::new(CHDMAN) from a module constant and run through run_tool: parse_chd runs `info -i` and scrapes Metadata/SHA1/Parent SHA1/Logical size/Data SHA1/TRACK lines from stdout; create_chd runs createcd|createdvd|createhd|createld with -i/-o plus optional --hunksize, --compression and -op; extract_chd runs the matching extract* with -o/-ob, a dotted cue path for CD, and -ip/-sb as needed.",
      "evidence": [
        {
          "resource": "repo://src/chdman.rs#L16-L16",
          "version": "repo-lines-v1:sha256:e774689aac3930e6201d300567ff0175615f57d6dbae5bff63941c5cc1d4ac87:"
