  "claims": [
    {
      "id": "claim_e2459c8758654a3e9c6a13f650ff3bd0",
      "statement": "util::run_tool is the single place oxyromon executes an external tool command: it logs the assembled tokio::process::Command with log::debug! before running it, converts a spawn failure into an anyhow context error naming the program, and on a non-zero exit bails carrying the child's stderr verbatim with no wrapper text, returning stdout untouched for the caller to parse.",
      "evidence": [
        {
          "resource": "repo://src/chdman.rs#L792-L794",
          "version": "repo-lines-v1:sha256:508abc04c1a26d457bbc57c048f2ce5674386556223f48e3c240d9c4abc448bc:"
        },
        {
          "resource": "repo://src/util.rs#L340-L353",
          "version": "repo-lines-v1:sha256:23436dbb634018b6bd243e3a13e2b2644c5c11e9e026e973769f4b8baebcc7b1:"
        }
      ]
    },
    {
      "id": "claim_52ba082be3a643a49997ee819ae86f10",
      "statement": "util::tool_version never checks the child's exit status, so get_version() returning Err means only that the executable could not be spawned (an availability test, not a version report), and it degrades to the literal string \"unknown\" when the regex does not match. chdman::get_version probes stdout line 0 with regex \\d+\\.\\d+, ctrtool::get_version probes stderr line 0 with \\d+\\.\\d+\\.\\d+.",
      "evidence": [
        {
          "resource": "repo://src/chdman.rs#L61-L61",
