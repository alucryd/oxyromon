    {
      "id": "claim_0c0dea1d37364ec69dddaa74e5b07cdf",
      "statement": "import-roms probes ctrtool per file just before dispatching a .cia import and, when the probe fails, prints \"Required tool not found: ctrtool\" and returns before the transaction commits — the file stays untouched on disk, no database row is written, and the rest of the import continues. No other extension is gated on an external tool: .chd now dispatches straight into the in-process import_chd.",
      "evidence": [
        {
          "resource": "repo://src/import_roms.rs#L476-L496",
          "version": "repo-lines-v1:sha256:81e568f989d66478909cd3e31c2dba3a7fcb74bfbe38991b82939d17687c38ae:"
