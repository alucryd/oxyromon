          "version": "repo-lines-v1:sha256:e8b6f8a2dda14eb4eb667d591a17d13a10fc7aef13bd9e32f95d7ce06421709e:"
        },
        {
          "resource": "repo://src/sort_roms/test_sort_1g1r_strict.rs#L48-L80",
          "version": "repo-lines-v1:sha256:932bc8c22ec5913e25d7bb05e9fc928a3f865cf5907616b5bb77017240ca5270:"
        }
      ]
    },
    {
      "id": "claim_57b78936a0554cb0a3e790ffd3a108e3",
      "statement": "sort_games_by_weight adds one point per satisfied preference — the parent under PREFER_PARENTS, the broader or narrower release under PREFER_REGIONS, the newer or older No-Intro version under PREFER_VERSIONS, and one point per matching flag under PREFER_FLAGS — and orders higher totals first, so the criteria are summed rather than applied in priority order.",
      "evidence": [
        {
          "resource": "repo://src/sort_roms.rs#L1174-L1187",
          "version": "repo-lines-v1:sha256:b8f7a10042b60e91a708bb1ca661df51c9ee3d69c190c23ffb550e8b552a8468:"
