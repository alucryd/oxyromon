        }
      ]
    },
    {
      "id": "claim_a3c6ce1bc5ce44f7860706522b259844",
      "statement": "In regions mode games go to the system directory only when one of their regions is in REGIONS_ALL, so ZZ there matches only games of unknown region rather than acting as the catch-all it is in hybrid mode.",
      "evidence": [
