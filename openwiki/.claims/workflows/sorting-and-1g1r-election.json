    {
      "id": "claim_70ba4573e4dd45f594589f98a495e5af",
      "statement": "sort_roms::main reads every classification input per system with that system's scope: REGIONS_ALL and REGIONS_ONE come from -r/--regions and -o/--1g1r when given and from the settings otherwise, alongside the arcade lists, LANGUAGES, DISCARD_RELEASES, DISCARD_FLAGS, the four PREFER_* settings and REGIONS_ONE_STRICT; region codes are parsed as TOSEC codes and an unparseable one panics.",
      "evidence": [
        {
          "resource": "repo://src/sort_roms.rs#L182-L203",
          "version": "repo-lines-v1:sha256:5fce0e5b289c4f5fe598c6f0d4de8005da91e0fed5500fd5d048d877e382e930:"
        },
        {
