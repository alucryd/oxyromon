  "query": "\n        SELECT rf.*\n        FROM romfiles rf\n        JOIN patches p ON p.romfile_id = rf.id\n        JOIN roms r ON r.id = p.rom_id\n        JOIN games g ON g.id = r.game_id\n        WHERE g.system_id = ?\n        ORDER BY rf.path;\n        ",
